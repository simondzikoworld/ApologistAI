ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM provider — "deepseek" (default) or "anthropic" to flip back to Claude
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# Optional overrides (leave unset for provider defaults)
# LLM_MODEL=deepseek-v4-flash
# LLM_BASE_URL=https://api.deepseek.com/anthropic
# Thinking mode: "off" (default) or "on" — thinking tokens bill as output
LLM_THINKING=off
